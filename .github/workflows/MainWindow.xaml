<Window
    x:Class="VOTASHI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VOTASHI">

    <Grid Background="#080D25">
        <!-- Фиолетовое свечение на фоне -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080D25" Offset="0.0" />
                <GradientStop Color="#171033" Offset="0.5" />
                <GradientStop Color="#11152F" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Центральный контент -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Место для твоего котика. Пока это просто текст -->
            <TextBlock Text="🐱" FontSize="100" HorizontalAlignment="Center"/>
            
            <TextBlock Text="VOTASHI" 
                       FontSize="72" 
                       FontWeight="Bold" 
                       Foreground="#F4F5FF" 
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
            
            <TextBlock Text="Твой идеальный рабочий стол" 
                       FontSize="20" 
                       Foreground="#A9B0D0" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,40"/>
            
            <Button Content="Начать путешествие" 
                    Background="#8B42FF" 
                    Foreground="White" 
                    Padding="30,15" 
                    CornerRadius="15"
                    FontSize="18"/>
        </StackPanel>
    </Grid>
</Window>
